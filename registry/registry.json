{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "emend",
  "homepage": "https://emend.dev",
  "items": [
    {
      "name": "ai-bubble-menu",
      "type": "registry:block",
      "title": "AI Bubble Menu",
      "description": "Selection-aware AI actions for an existing Tiptap editor.",
      "dependencies": [
        "@emend/ai",
        "@hugeicons/core-free-icons@4.2.3",
        "@hugeicons/react@^1.1.9",
        "@tiptap/extension-bold@3.30.1",
        "@tiptap/extension-italic@3.30.1",
        "@tiptap/extension-link@3.30.1",
        "@tiptap/extension-text-style@3.30.1",
        "@tiptap/extension-underline@3.30.1",
        "@tiptap/react@3.30.1",
        "clsx@^2.1.1",
        "tailwind-merge@^3.6.0"
      ],
      "registryDependencies": ["button", "input-group", "tooltip"],
      "files": [
        {
          "path": "registry/components/ai-bubble-menu/ai-bubble-menu.tsx",
          "type": "registry:component",
          "target": "components/emend/ai-bubble-menu/ai-bubble-menu.tsx"
        },
        {
          "path": "registry/components/ai-bubble-menu/index.ts",
          "type": "registry:component",
          "target": "components/emend/ai-bubble-menu/index.ts"
        },
        {
          "path": "registry/components/_shared/use-emend-ai-session.ts",
          "type": "registry:hook",
          "target": "components/emend/_shared/use-emend-ai-session.ts"
        },
        {
          "path": "packages/ui/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
