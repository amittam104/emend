{
  "name": "@emend/ai",
  "version": "0.0.0",
  "description": "Provider-neutral human-in-the-loop AI editing runtime for Tiptap.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tiptap/core": "3.30.1",
    "@tiptap/markdown": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "9",
    "tsdown": "^0.21.10",
    "typescript": "5"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./proposal": {
      "types": "./dist/proposal/index.d.ts",
      "import": "./dist/proposal/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tiptap/core": "3.30.1",
    "@tiptap/markdown": "3.30.1",
    "@tiptap/pm": "3.30.1"
  },
  "dependencies": {
    "eventsource-parser": "^4.0.0"
  }
}
